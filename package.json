{
  "name": "webmcp-selenium",
  "version": "1.0.0",
  "description": "A local MCP server that uses Selenium to crawl websites and a local ML model via Transformers.js to analyze the DOM for test recommendations.",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "build:browser": "esbuild src/analyzer.ts --bundle --format=iife --global-name=DomAnalyzerBundle --platform=browser --target=es2020 --outfile=build/analyzer.browser.js",
    "start": "npm run build && npm run build:browser && node build/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build && npm run build:browser",
    "pretest": "npm run build && npm run build:browser",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "pretest:coverage": "npm run build && npm run build:browser",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='build/**' --test-coverage-exclude='build/test/**' --test-coverage-exclude='build/analyzer.browser.js' --test-coverage-exclude='build/types.js' --test-coverage-lines=89 --test-coverage-branches=90 --test-coverage-functions=92 test/unit/*.test.js",
    "benchmark:install": "npm --prefix benchmark/app install --no-audit --no-fund"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "selenium-webdriver": "^4.27.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/selenium-webdriver": "^4.1.26",
    "esbuild": "^0.27.3",
    "ts-node": "^10.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
