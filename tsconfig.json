{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "outDir": "./build",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/types.ts",
    "src/crawler.ts",
    "src/test-case-generator.ts",
    "src/markdown-exporter.ts",
    "src/webmcp-semantic-tools.ts",
    "src/webmcp-semantic-handlers.ts",
    "src/session-manager.ts",
    "src/multi-page-crawler.ts",
    "src/workflow-detector.ts",
    "src/embedding-cache.ts",
    "src/heuristic-scorer.ts",
    "src/locator-generator.ts",
    "src/browser-pipeline.ts",
    "src/advanced-workflow-detector.ts",
    "src/performance-optimizer.ts",
    "src/index.ts"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}
