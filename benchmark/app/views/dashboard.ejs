<%- include('partials/header', { title }) %>

<section id="dashboard" class="dashboard">

  <header class="dashboard-header">
    <h1 id="welcome-message">Welcome back, <%= user.name %>!</h1>
    <p id="dashboard-subtitle" class="text-muted">Here's your account overview.</p>
  </header>

  <div class="dashboard-grid">

    <article id="account-card" class="card">
      <h2 class="card-title">Account Details</h2>
      <dl class="detail-list">
        <dt>Name</dt>     <dd id="account-name"><%= user.name %></dd>
        <dt>Username</dt> <dd id="account-username"><%= user.username %></dd>
        <dt>Email</dt>    <dd id="account-email"><%= user.email %></dd>
      </dl>
      <div class="card-actions">
        <a id="edit-profile-btn" href="/account/profile" class="btn btn-secondary">Edit Profile</a>
      </div>
    </article>

    <article id="quick-links-card" class="card">
      <h2 class="card-title">Quick Links</h2>
      <nav id="dashboard-quick-links" class="quick-links">
        <a id="dashboard-shop-link"    href="/products" class="quick-link-btn">🛍️ Shop Products</a>
        <a id="dashboard-deals-link"   href="/deals"    class="quick-link-btn">🏷️ View Deals</a>
        <a id="dashboard-cart-link"    href="/cart"     class="quick-link-btn">🛒 View Cart</a>
        <a id="dashboard-contact-link" href="/contact"  class="quick-link-btn">📬 Contact Us</a>
      </nav>
    </article>

    <article id="recent-orders-card" class="card card-full">
      <h2 class="card-title">Recent Orders</h2>
      <% if (recentOrders.length === 0) { %>
        <p id="no-orders-msg" class="text-muted">No orders yet. <a href="/products">Start shopping!</a></p>
      <% } else { %>
        <table id="orders-table" class="data-table">
          <thead>
            <tr>
              <th>Order #</th>
              <th>Date</th>
              <th>Items</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            <% recentOrders.forEach(order => { %>
            <tr id="order-row-<%= order.orderNumber %>">
              <td><span class="order-number"><%= order.orderNumber %></span></td>
              <td><%= new Date(order.date).toLocaleDateString() %></td>
              <td><%= order.items.length %> item(s)</td>
              <td>$<%= order.total %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </article>

  </div>

</section>

<%- include('partials/footer') %>
